# Скопируйте этот файл в .env и вставьте ключи.

# Бесплатный поиск страниц товара по штрихкоду: Tavily, 1000 запросов в месяц без карты —
# https://app.tavily.com. Без ключа используется DuckDuckGo, но он быстро начинает показывать капчу.
TAVILY_API_KEY=вставьте_сюда_ключ

# Разбор найденных страниц бесплатными моделями OpenRouter (кредиты не нужны, до 50 запросов в день).
# Без ключа состав разбирается правилами без ИИ.
OPENROUTER_API_KEY=вставьте_сюда_ключ
# OPENROUTER_FREE_MODELS=minimax/minimax-m3.1-flash:free,openrouter/free

# Необязательно: платный веб-поиск OpenRouter для того, что бесплатный поиск не нашёл.
# Выключите (0), если на балансе OpenRouter нет кредитов, чтобы не тратить время на отказ.
# OPENROUTER_WEB_SEARCH=1
# OPENROUTER_MODEL=openai/gpt-4o-mini
# OPENROUTER_WEB_RESULTS=3

# Необязательно: Gemini с поиском Google (не работает из России и без платного тарифа).
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash

# Сколько дней хранить найденный состав в базе (повторные сканы не тратят лимиты).
# AI_CACHE_DAYS=30

# Подбор товаров и рецептов под «Что мне нельзя»: правила по словам работают всегда,
# а с OPENROUTER_API_KEY нейросеть в фоне ищет неочевидные совпадения (бешамель — это молоко).
# Выключить нейросеть для этой проверки: DIET_AI=0
